<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/crna">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/crna"
        app:navigationIcon="@drawable/outline_arrow_back_24"
        app:navigationIconTint="@color/bijela" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/workoutTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upper Body Strength"
            android:textColor="@color/bijela"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/workoutTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="| 18:00 "
                android:textColor="@color/svijetlo_siva"
                android:textSize="14sp"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/workoutDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="| 45 min"
                android:textColor="@color/svijetlo_siva"
                android:textSize="14sp"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/workoutExerciseCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="| 5 vježbi"
                android:textColor="@color/svijetlo_siva"
                android:textSize="14sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/exercisesHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VJEŽBE (0/5 ZAVRŠENO)"
            android:textColor="@color/svijetlo_siva"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/exercisesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="5"
                tools:listitem="@layout/item_workout_exercise" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/startWorkoutButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Počni trening"
        android:textColor="@color/bijela"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="16dp"
        app:backgroundTint="@color/crvena"
        app:cornerRadius="12dp" />

</LinearLayout>

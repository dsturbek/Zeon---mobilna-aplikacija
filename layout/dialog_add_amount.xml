<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/pozadina_card"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvFoodName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_food_naziv_hrane"
        android:textColor="@color/bijela"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvFoodInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="165 kcal | 31g Proteina | 3g Masti | 0g Ugljikohidrata"
        android:textColor="@color/siva"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/tvAmountLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Količina (grama)"
        android:textColor="@color/svijetlo_siva"
        android:textSize="14sp"
        android:textStyle="bold"
        android:labelFor="@id/etAmount"/>

    <EditText
        android:id="@+id/etAmount"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:inputType="numberDecimal"
        android:hint="@string/add_food_hint_text"
        android:text="100"
        android:textColor="@color/bijela"
        android:textColorHint="@color/svijetlo_siva"
        android:textSize="18sp"
        android:gravity="center"
        android:background="@color/siva"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/meal_type_text"
        android:textColor="@color/svijetlo_siva"
        android:textSize="14sp"
        android:textStyle="bold"
        android:labelFor="@id/spinnerMealType"/>

    <Spinner
        android:id="@+id/spinnerMealType"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/siva"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        />

    <TextView
        android:id="@+id/tvCalculated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/food_list_item_description"
        android:textColor="@color/crvena"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnDodaj"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/button_text_dodaj"
            android:textColor="@color/bijela"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/crvena"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            />
        <Button
            android:id="@+id/btnOdustani"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/button_text_odustani"
            android:textColor="@color/svijetlo_siva"
            android:textSize="16sp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginStart="12dp"/>

    </LinearLayout>



</LinearLayout>
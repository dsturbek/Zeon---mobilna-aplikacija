<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/pozadina_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/exerciseNumber"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="1"
            android:textColor="@color/bijela"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/rounded_badge_red_small"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/exerciseName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bench Press"
                android:textColor="@color/bijela"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/exerciseMuscleGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chest, Triceps"
                android:textColor="@color/svijetlo_siva"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/exerciseSetsReps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 sets × 10 reps"
                    android:textColor="@color/bijela"
                    android:textSize="14sp"
                    android:background="@drawable/rounded_pill_gray"
                    android:padding="6dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/exerciseWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60 kg"
                    android:textColor="@color/bijela"
                    android:textSize="14sp"
                    android:background="@drawable/rounded_pill_gray"
                    android:padding="6dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/exerciseCheckbox"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:button="@null"
            android:background="@drawable/checkbox_selector"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />

    </LinearLayout>

</androidx.cardview.widget.CardView>

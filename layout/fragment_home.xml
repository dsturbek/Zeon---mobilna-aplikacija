<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crna"
    tools:context=".presentation.ui.fragments.HomeFragment">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dobrodošao"
            android:textColor="@color/bijela"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Danas"
            android:textColor="@color/bijela"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <androidx.cardview.widget.CardView
            android:id="@+id/todayWorkoutCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/pozadina_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/todayWorkoutIcon"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/muscle_icon"
                        android:scaleType="centerInside"
                        android:padding="12dp"
                        android:background="@drawable/rounded_icon_bg"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="Icon description" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/todayWorkoutTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Upper Body Strength"
                            android:textColor="@color/bijela"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">

                            <TextView
                                android:id="@+id/todayWorkoutTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="18:00"
                                android:textColor="@color/svijetlo_siva"
                                android:textSize="14sp"
                                android:layout_marginEnd="16dp"/>

                            <TextView
                                android:id="@+id/todayWorkoutDuration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" 45 min"
                                android:textColor="@color/svijetlo_siva"
                                android:textSize="14sp"/>
                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/todayBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_badge_red"
                        android:padding="6dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="DANAS"
                        android:textColor="@color/bijela"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:id="@+id/noWorkoutLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="32dp"
                        android:background="@drawable/rounded_icon_bg"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@android:drawable/ic_menu_today"
                            app:tint="@color/black"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/noWorkoutMessage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Danas nemaš planiranih treninga"
                            android:textColor="@color/bijela"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Iskoristi dan za odmor ili dodaj novi!"
                            android:textColor="@color/bijela"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp"
                            android:gravity="center"/>
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/todayWorkoutExercises"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 vježbi"
                        android:textColor="@color/bijela"
                        android:textSize="14sp"
                        android:background="@drawable/rounded_pill_gray"
                        android:padding="8dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/todayWorkoutMuscleGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prsa, Triceps"
                        android:textColor="@color/bijela"
                        android:textSize="14sp"
                        android:background="@drawable/rounded_pill_gray"
                        android:padding="8dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"/>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>